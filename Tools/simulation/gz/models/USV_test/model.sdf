<?xml version='1.0'?>
<sdf version='1.9'>
  <model name='USV_test'>
    <static>false</static>
    <self_collide>false</self_collide>
    <pose>0 0 .24 0 0 0</pose>

    <!-- Disco Centrale -->
    <link name='base_link'>
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <inertial>
        <mass>4.0</mass>
