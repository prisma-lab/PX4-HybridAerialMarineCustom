    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <joint_name>left_th_joint</joint_name>
      <thrust_coefficient>0.00004422</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.9</propeller_diameter>
      <velocity_control>false</velocity_control>
      <max_thrust_cmd>1</max_thrust_cmd>
