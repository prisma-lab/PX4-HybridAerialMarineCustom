    <!-- Giunti per collegare i galleggianti e base link -->
    <joint name='left_joint' type='fixed'>
      <parent>base_link</parent>
      <child>left_floater</child>
    </joint>
    <joint name='right_joint' type='fixed'>
      <parent>base_link</parent>
      <child>right_floater</child>
    </joint>
    
