    <!--Plugin galleggiamento-->
    <plugin filename="libSurfaceUSV.so" name="vrx::SurfaceUSV">
      <link_name>base_link</link_name>
      <hull_height>1</hull_height>
      <hull_radius>0.075</hull_radius>
      <fluid_level>0.0</fluid_level>
      <fluid_density>997</fluid_density>
      <points>
        <point>0 0.3 0</point>
        <point>0.05 0.3 0</point>
        <point>0.015 0.3 0</point>
        <point>0.025 0.3 0</point>
        <point>0.035 0.3 0</point>
        <point>0.045 0.3 0</point>
        <point>-0.05 0.3 0</point>
        <point>-0.015 0.3 0</point>
        <point>-0.025 0.3 0</point>
        <point>-0.035 0.3 0</point>
        <point>-0.045 0.3 0</point>
      </points>
      <wavefield>
        <size>6000 6000</size>
     		<cell_count>500 500</cell_count>
        <topic>/vrx/wavefield/parameters</topic>
      </wavefield>
    </plugin>
    <plugin filename="libSurfaceUSV.so" name="vrx::SurfaceUSV">
      <link_name>base_link</link_name>
      <hull_height>1</hull_height>
      <hull_radius>0.075</hull_radius>
      <fluid_level>0.0</fluid_level>
      <fluid_density>997</fluid_density>
      <points>
        <point>0 -0.3 0</point>
        <point>0.05 -0.3 0</point>
        <point>0.015 -0.3 0</point>
        <point>0.025 -0.3 0</point>
        <point>0.035 -0.3 0</point>
        <point>0.045 -0.3 0</point>
        <point>-0.05 -0.3 0</point>
        <point>-0.015 -0.3 0</point>
        <point>-0.025 -0.3 0</point>
        <point>-0.035 -0.3 0</point>
        <point>-0.045 -0.3 0</point>
      </points>
      <wavefield>
        <size>6000 6000</size>
     		<cell_count>500 500</cell_count>
        <topic>/vrx/wavefield/parameters</topic>
      </wavefield>
    </plugin>

    <plugin
        filename="libSimpleHydrodynamicsUSV.so"
        name="vrx::SimpleHydrodynamicsUSV">
        <link_name>base_link</link_name>
        <!-- Added mass -->
        <xDotU>0.0</xDotU>
        <yDotV>0.0</yDotV>
        <nDotR>0.0</nDotR>
        <!-- Linear and quadratic drag -->
        <!-- <xU>100.0</xU>
